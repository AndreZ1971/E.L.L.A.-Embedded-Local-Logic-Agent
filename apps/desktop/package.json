{
  "name": "@ella/desktop",
  "version": "1.2.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "node build-main.mjs",
    "dev": "node build-main.mjs && electron .",
    "build": "node build-main.mjs",
    "dist": "node build-main.mjs && node build-icon.mjs && electron-builder --win nsis",
    "dist:msix": "node build-main.mjs && node build-icon.mjs && electron-builder --win appx",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),c=process.cwd();const l=p.join(c,'node_modules','electron'),t=p.join(c,'..','..','node_modules','electron');if(!fs.existsSync(t))process.exit(0);try{fs.rmSync(l,{recursive:true,force:true})}catch(e){}try{fs.symlinkSync(t,l,'junction');console.log('electron junction OK')}catch(e){console.warn('junction failed:',e.message)}\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "build": {
    "appId": "de.ella.app",
    "productName": "E.L.L.A.",
    "asar": false,
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../../apps/api/dist",
        "to": "api/dist",
        "filter": [
          "bundle.cjs",
          "*.node"
        ]
      },
      {
        "from": "../../apps/api/prod-node-modules/node_modules",
        "to": "api/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../apps/web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../vendor/mariadb",
        "to": "mariadb",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../vendor/ollama",
        "to": "ollama",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../vendor/node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../database/schema.sql",
        "to": "database/schema.sql"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "appx": {
      "applicationId": "ELLAApp",
      "backgroundColor": "#0f1117",
      "displayName": "E.L.L.A.",
      "identityName": "ELLAApp",
      "publisher": "CN=Andre Zabel",
      "publisherDisplayName": "Andre Zabel",
      "languages": [
        "de-DE",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "E.L.L.A.",
      "uninstallDisplayName": "E.L.L.A. — Embedded Local Logic Agent",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}
